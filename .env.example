# Telegram Bot Tokens
ANDROID_APP_BOT_TOKEN=your_android_bot_token_here
SWING_TRADING_BOT_TOKEN=your_swing_trading_bot_token_here
GEO_POLITICS_BOT_TOKEN=your_geo_politics_bot_token_here
ROAST_BOT_TOKEN=your_roast_bot_token_here
CONDITIONS_BOT_TOKEN=your_conditions_bot_token_here
MANIFESTATION_BOT_TOKEN=your_manifestation_bot_token_here

# Webhook URL (optional - if set, uses webhook; otherwise uses polling)
WEBHOOK_URL=https://your-domain.com

# AI Provider (OpenAI-compatible API)
# For OpenCode Zen → DeepSeek V4 Flash Free:
#   1. Get your API key at https://opencode.ai/auth
#   2. Use settings below:
AI_API_KEY=your_opencode_zen_api_key_here
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=deepseek-v4-flash-free

# File Server (for APK builds, file uploads)
FILESERVER_URL=http://79.143.189.251

# Market Data (Yahoo Finance — no API key needed, works server-side)
# WATCHLIST_SYMBOLS=SPY,QQQ,IWM,AAPL,MSFT,NVDA,META,TSLA,AMZN,GOOGL

# Access Control — Telegram usernames allowed to use the bots (comma-separated, lowercase)
# Leave empty to allow everyone. Per-bot override: ALLOWED_USERNAMES_ANDROID_APP=johndoe,janedoe
# ALLOWED_USERNAMES=johndoe,janedoe
